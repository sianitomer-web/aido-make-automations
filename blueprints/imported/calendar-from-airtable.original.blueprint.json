      "version": 1,
      "metadata": {
        "restore": { "extra": { "feeder": {}, "target": {} } },
        "designer": { "x": 600, "y": 0 }
      },
      "parameters": { "feeder": 3, "target": "2.attendees" }
    },
    {
      "id": 2,
      "mapper": {
        "end": "2023-01-01T17:30:00.000Z",
        "start": "2023-01-01T17:00:00.000Z",
        "select": "detail",
        "summary": "Event{{1.name}}",
        "calendar": "b0aab980cb335d2a1f1d2a8cdca341c247dbdbbed6b5eb5cda6c1584f5090d32@group.calendar.google.com",
        "attendees": "{{5.array}}",
        "visibility": "default",
